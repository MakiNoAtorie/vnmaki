      "environment": {
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "system-tsan",
      "configurePreset": "system-tsan",
      "inherits": [
        "test-base"
      ]
    },
    {
      "name": "system-fuzz",
      "configurePreset": "system-fuzz",
      "inherits": [
        "test-base"
      ],
      "environment": {
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "system-clang-tidy",
      "configurePreset": "system-clang-tidy",
      "inherits": [
        "test-base"
      ]
    }
  ],
