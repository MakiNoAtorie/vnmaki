{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "cfg-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "cfg-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "cfg-asan-ubsan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VNMAKI_SANITIZERS": "address;undefined"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "cfg-tsan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VNMAKI_SANITIZERS": "thread"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "cfg-fuzz",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "VNMAKI_SANITIZERS": "address;undefined",
        "VNMAKI_BUILD_FUZZERS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "cfg-clang-tidy",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy",
        "VNMAKI_BUILD_FUZZERS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "debug",
      "displayName": "debug",
      "description": "Debug: warnings as errors, hardened standard library (dependencies from vcpkg; needs VCPKG_ROOT)",
      "inherits": [
        "base",
        "vcpkg",
        "cfg-debug"
      ]
    },
    {
      "name": "release",
      "displayName": "release",
      "description": "Release: optimized build (dependencies from vcpkg; needs VCPKG_ROOT)",
      "inherits": [
        "base",
        "vcpkg",
        "cfg-release"
      ]
    },
    {
      "name": "asan-ubsan",
      "displayName": "asan-ubsan",
      "description": "Debug with AddressSanitizer and UndefinedBehaviorSanitizer (dependencies from vcpkg; needs VCPKG_ROOT)",
      "inherits": [
        "base",
        "vcpkg",
        "cfg-asan-ubsan"
      ]
    },
    {
      "name": "tsan",
      "displayName": "tsan",
      "description": "Debug with ThreadSanitizer (dependencies from vcpkg; needs VCPKG_ROOT)",
      "inherits": [
        "base",
        "vcpkg",
        "cfg-tsan"
      ]
    },
    {
      "name": "fuzz",
      "displayName": "fuzz",
      "description": "libFuzzer targets with ASan and UBSan (LLVM Clang) (dependencies from vcpkg; needs VCPKG_ROOT)",
      "inherits": [
        "base",
        "vcpkg",
        "cfg-fuzz"
      ]
    },
    {
      "name": "clang-tidy",
      "displayName": "clang-tidy",
      "description": "Debug build (fuzzers included) that runs clang-tidy on every first-party file (dependencies from vcpkg; needs VCPKG_ROOT)",
      "inherits": [
        "base",
        "vcpkg",
        "cfg-clang-tidy"
      ]
    },
    {
      "name": "system-debug",
      "displayName": "system-debug",
      "description": "Debug: warnings as errors, hardened standard library (dependencies from system packages; no vcpkg)",
      "inherits": [
        "base",
        "cfg-debug"
      ]
    },
    {
      "name": "system-release",
      "displayName": "system-release",
      "description": "Release: optimized build (dependencies from system packages; no vcpkg)",
      "inherits": [
        "base",
        "cfg-release"
      ]
    },
    {
      "name": "system-asan-ubsan",
      "displayName": "system-asan-ubsan",
      "description": "Debug with AddressSanitizer and UndefinedBehaviorSanitizer (dependencies from system packages; no vcpkg)",
      "inherits": [
        "base",
        "cfg-asan-ubsan"
      ]
    },
    {
      "name": "system-tsan",
      "displayName": "system-tsan",
      "description": "Debug with ThreadSanitizer (dependencies from system packages; no vcpkg)",
      "inherits": [
        "base",
        "cfg-tsan"
      ]
    },
    {
      "name": "system-fuzz",
      "displayName": "system-fuzz",
      "description": "libFuzzer targets with ASan and UBSan (LLVM Clang) (dependencies from system packages; no vcpkg)",
      "inherits": [
        "base",
        "cfg-fuzz"
      ]
    },
    {
      "name": "system-clang-tidy",
      "displayName": "system-clang-tidy",
      "description": "Debug build (fuzzers included) that runs clang-tidy on every first-party file (dependencies from system packages; no vcpkg)",
      "inherits": [
        "base",
        "cfg-clang-tidy"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan-ubsan",
