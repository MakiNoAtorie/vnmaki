    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "inherits": [
        "test-base"
      ]
    },
    {
      "name": "release",
      "configurePreset": "release",
      "inherits": [
        "test-base"
      ]
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "inherits": [
        "test-base"
      ],
      "environment": {
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
