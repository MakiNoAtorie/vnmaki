---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 100
IndentWidth: 2
PointerAlignment: Left
DerivePointerAlignment: false
IncludeBlocks: Regroup
# Own header first, then the standard library, then third-party libraries,
# then other VNMaki headers.
IncludeCategories:
  - Regex: '^<[a-z_]+>$'
    Priority: 1
  # Other Windows headers need windows.h first.
  - Regex: '^<windows\.h>$'
    Priority: 2
    SortPriority: 2
  - Regex: '^<'
    Priority: 2
    SortPriority: 3
  - Regex: '^"'
    Priority: 3
    SortPriority: 4
...
