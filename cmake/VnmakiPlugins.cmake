# C++ plugins (task 48, docs/plugins.md).
#
# vnmaki_add_plugin(<name> SOURCES <file>...)
#   Makes the static library vnmaki_plugin_<name>. The sources define
#   `void vnmaki::register_plugin_<name>(vnmaki::PluginContext&)`.
#
# vnmaki_link_plugins(<target>)
#   Links the plugins of -DVNMAKI_PLUGINS=a;b into <target> (the runner) and adds a generated
#   source file that registers them in PluginContext::linked() before main().

set(VNMAKI_PLUGINS
    ""
    CACHE STRING "C++ plugins to link into the runner: a list of names from plugins/")

function(vnmaki_add_plugin name)
  cmake_parse_arguments(PARSE_ARGV 1 arg "" "" "SOURCES")
  if(NOT name MATCHES "^[a-z][a-z0-9_]*$")
    message(FATAL_ERROR "vnmaki_add_plugin: '${name}' must be lower case letters, digits and '_'")
  endif()
  if(NOT arg_SOURCES)
    message(FATAL_ERROR "vnmaki_add_plugin(${name}): SOURCES is empty")
  endif()
  add_library(vnmaki_plugin_${name} STATIC ${arg_SOURCES})
  target_link_libraries(vnmaki_plugin_${name} PUBLIC vnmaki::engine PRIVATE vnmaki::options)
  set_property(GLOBAL APPEND PROPERTY VNMAKI_PLUGIN_NAMES ${name})
endfunction()

function(vnmaki_link_plugins target)
  if(NOT VNMAKI_PLUGINS)
    return()
  endif()
  get_property(known GLOBAL PROPERTY VNMAKI_PLUGIN_NAMES)
  set(declarations "")
  set(calls "")
  foreach(name IN LISTS VNMAKI_PLUGINS)
    if(NOT name IN_LIST known)
      message(FATAL_ERROR "VNMAKI_PLUGINS has '${name}', but no plugin has that name "
                          "(vnmaki_add_plugin in plugins/<name>/CMakeLists.txt). Known: ${known}")
    endif()
    string(APPEND declarations "void register_plugin_${name}(PluginContext& context);\n")
    string(APPEND calls "  add(\"${name}\", vnmaki::register_plugin_${name});\n")
    target_link_libraries(${target} PRIVATE vnmaki_plugin_${name})
  endforeach()
  set(source "${CMAKE_CURRENT_BINARY_DIR}/linked_plugins.cpp")
  file(
    CONFIGURE
    OUTPUT "${source}"
    CONTENT
      "// Generated by cmake/VnmakiPlugins.cmake from VNMAKI_PLUGINS=${VNMAKI_PLUGINS}.
#include <cstdlib>
#include <exception>
#include <iostream>

#include \"engine/plugin/plugin.hpp\"

namespace vnmaki {
${declarations}}  // namespace vnmaki

namespace {

// A plugin that cannot register stops the program at start, with its name.
[[maybe_unused]] const bool kRegistered = [] {
  const auto add = [](const char* name, void (*register_plugin)(vnmaki::PluginContext&)) {
    try {
      register_plugin(vnmaki::PluginContext::linked());
    } catch (const std::exception& error) {
      std::cerr << \"vnmaki: plugin '\" << name << \"': \" << error.what() << '\\n';
      std::exit(1);
    }
  };
${calls}  return true;
}();

}  // namespace
"
    @ONLY)
  target_sources(${target} PRIVATE "${source}")
endfunction()
